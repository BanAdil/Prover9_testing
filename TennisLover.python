#This problem is a bit different from most of the others ones. 
#Rather than being given a specific goal, you need to find an appropriate goal, 
#which both answers the question and is provable from the assumptions. You should try possible 
#goals one at a time, until you find one that is provable.
#A1	If I'm not playing tennis, I'm watching tennis.
#A2	If I'm not watching tennis, I'm reading about tennis.
#A3	I cannot do more than one tennis-related activity at the same time. *
#Goal	What am I doing? **


import pyprover9

Assumptions = """

    -PlayingTennis -> WatchingTennis.

    -WatchingTennis -> ReadingTennis.

    -(PlayingTennis & WatchingTennis).

    -(PlayingTennis & ReadingTennis).

    -(WatchingTennis & ReadingTennis).

"""

Goal = """

    WatchingTennis.

"""

pyprover9.prove(Assumptions, Goal)

